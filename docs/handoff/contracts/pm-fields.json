{
  "version": "1.0",
  "purpose": "Field dictionary for the planned application; not populated business data or an executable JSON Schema.",
  "storage_mapping": {
    "candidate": "products.id/facts_json + offers + evidence",
    "outcome": "metric_snapshots.metrics_json + reviews.outcome(result_status) + reviews.findings_json(final_outcome)",
    "prediction": "predictions columns + input_json/result_json"
  },
  "rules": [
    "CSV blank is null. Required identifiers/scope cannot be blank; invalid rows produce row-level errors.",
    "CSV export of object fields is JSON; import validates it, never evals it.",
    "ISO timestamps carry timezones; monetary values use Decimal and currency.",
    "Configured dimension values carry their scale/config version and may be null when unavailable.",
    "Rate definitions may legitimately differ: conversion counts must match their denominator. Do not clamp negative margin rates or substitute zero for unknown.",
    "is_synthetic is never converted to real by import; production outcomes reject synthetic rows.",
    "Observed field provenance and scope are mandatory for decisions, even where values themselves are optional.",
    "No monetary or scale threshold is silently invented; missing trial budget/success configuration yields WAIT."
  ],
